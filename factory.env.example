# caveman: per-project config. copy to factory.env and edit.
# factory.env is sourced by scripts/run_antigravity.sh. shell syntax.
# no secrets here - this file is committed.

# test command, run from repo root. required.
TEST_CMD="pytest -q"
# TEST_CMD="npm test"
# TEST_CMD="go test ./..."
# TEST_CMD="cargo test"

# models agy tries, in order. first one that RUNS wins - the script falls
# through only when agy itself fails (bad id, quota, transport), not when the
# build fails. ids are validated against `agy models` and rotate often, so
# check with `agy models` rather than trusting this list.
AGY_MODELS="claude-sonnet-4-6 gemini-3.1-pro-high gemini-3.6-flash-high"

# optional single model, tried before the chain. /factory-build sets this per
# task with --model instead of editing the file.
AGY_MODEL=""

# how long to wait for one agy run
AGY_TIMEOUT="30m"

# max agy rounds /factory-build will run before stopping and asking.
# each round costs real money and time.
MAX_ROUNDS="3"
