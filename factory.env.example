# caveman: per-project config. copy to factory.env and edit.
# factory.env is sourced by scripts/run_antigravity.sh. shell syntax.
# no secrets here - this file is committed.

# test command, run from repo root. required.
TEST_CMD="pytest -q"
# TEST_CMD="npm test"
# TEST_CMD="go test ./..."
# TEST_CMD="cargo test"

# no model ids in this file on purpose - they rotate and a pinned id rots
# silently. the model comes from `agy models` at run time: /factory-build
# picks one per task, or pass --model, or the script takes the first listed.

# where /factory-reflect forwards its proposals: a local ai-factory checkout.
# they are appended to <checkout>/factory/improvements.md, the shared inbox.
# the path is per machine, so set it in your shell profile rather than here.
# unset = skipped, with a note. never point it at the vendored factory-engine/.
# FACTORY_UPSTREAM="$HOME/work/ai-factory"

# how many other models to try if agy itself fails to run (bad id, quota,
# transport). does not retry a failed build - that is the builder's problem.
AGY_FALLBACKS="2"

# how long to wait for one agy run
AGY_TIMEOUT="30m"

# max agy rounds /factory-build will run before stopping and asking.
# each round costs real money and time. the counter is the number of logs in
# handoffs/, not something an agent remembers - so a session that dies and
# resumes cannot quietly start the budget over. see scripts/factory_state.sh.
MAX_ROUNDS="3"
